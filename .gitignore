# House style: zips and docx are outputs, not sources of truth.
*.zip
*.docx

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~

# Netlify local state/build cache (regenerated by netlify CLI)
.netlify/

# Mount/sync artifacts
.fuse_hidden*

# Credentials — never commit
.env
.env.*
*.pem
*.key
*netlify-token*
